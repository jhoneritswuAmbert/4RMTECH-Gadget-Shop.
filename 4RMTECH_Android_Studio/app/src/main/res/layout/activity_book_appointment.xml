<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_header_gradient" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="16dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_media_previous" android:tint="@color/white" android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Book Appointment" android:textColor="@color/white" android:textSize="20sp" android:fontFamily="sans-serif" android:layout_marginStart="4dp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/confirmationLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="32dp" android:visibility="gone">
        <View android:layout_width="64dp" android:layout_height="64dp" android:background="@color/card_green_bg" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Appointment Booked!" android:textColor="@color/navy" android:textSize="20sp" android:fontFamily="sans-serif" android:layout_marginTop="16dp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your appointment is pending confirmation." android:textColor="@color/text_secondary" android:textSize="13sp" android:gravity="center" android:layout_marginTop="8dp" />
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:cardCornerRadius="18dp" app:cardElevation="1dp" app:cardBackgroundColor="@color/white">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Booking Summary" android:textColor="@color/navy" android:textSize="15sp" android:fontFamily="sans-serif" android:layout_marginBottom="12dp" android:textStyle="bold" />
                <TextView android:id="@+id/tvConfirmDevice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/navy" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/tvConfirmDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/tvConfirmTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="2dp" />
                <TextView android:id="@+id/tvConfirmIssue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <Button android:id="@+id/btnGoHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Go Back" android:textColor="#0B1748" android:background="@drawable/bg_button_primary" android:textAllCaps="false" android:letterSpacing="0.01" android:fontFamily="sans-serif-medium" android:minHeight="52dp" android:backgroundTint="#CEE800" app:backgroundTint="#CEE800" />
    </LinearLayout>
    <ScrollView android:id="@+id/formLayout" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="Full Name" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" app:boxBackgroundColor="@color/white" app:boxStrokeColor="@color/ui_field_stroke" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCustomerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_dark" android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="Contact Number" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" app:boxBackgroundColor="@color/white" app:boxStrokeColor="@color/ui_field_stroke" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etContact" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:textColor="@color/text_dark" android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="Device Type" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" app:boxBackgroundColor="@color/white" app:boxStrokeColor="@color/ui_field_stroke" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                <AutoCompleteTextView android:id="@+id/actvDeviceType" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="Device Brand &amp; Model" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" app:boxBackgroundColor="@color/white" app:boxStrokeColor="@color/ui_field_stroke" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDeviceModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_dark" android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="Describe the Issue" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" app:boxBackgroundColor="@color/white" app:boxStrokeColor="@color/ui_field_stroke" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etIssue" android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="3" android:gravity="top" android:inputType="textMultiLine" android:textColor="@color/text_dark" android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="Preferred date" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" app:boxBackgroundColor="@color/white" app:boxStrokeColor="@color/ui_field_stroke" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" android:id="@+id/dateInputLayout" app:endIconMode="custom" app:endIconDrawable="@android:drawable/ic_menu_my_calendar" app:endIconContentDescription="Choose preferred date" app:endIconTint="#0B1748">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_dark" android:textSize="16sp" android:focusable="false" android:clickable="true" android:inputType="none" android:cursorVisible="false" android:longClickable="false" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:hint="Preferred Time" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" app:boxBackgroundColor="@color/white" app:boxStrokeColor="@color/ui_field_stroke" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                <AutoCompleteTextView android:id="@+id/actvTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <Button android:id="@+id/btnSubmit" android:layout_width="match_parent" android:layout_height="52dp" android:text="Book Appointment" android:textColor="#0B1748" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:background="@drawable/bg_button_primary" android:textAllCaps="false" android:letterSpacing="0.01" android:minHeight="52dp" android:backgroundTint="#CEE800" app:backgroundTint="#CEE800" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>