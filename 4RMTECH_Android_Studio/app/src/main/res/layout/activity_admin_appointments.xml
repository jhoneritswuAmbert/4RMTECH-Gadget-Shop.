<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_header_gradient" android:paddingStart="12dp" android:paddingTop="16dp" android:paddingEnd="20dp" android:paddingBottom="16dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Back" android:src="@android:drawable/ic_media_previous" app:tint="@color/white" />
        <TextView android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center_vertical" android:text="Appointments" android:textColor="@color/white" android:textSize="22sp" android:fontFamily="sans-serif" android:textStyle="bold" />
    </LinearLayout>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="12dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" app:boxBackgroundColor="@color/white" app:boxStrokeColor="@color/ui_field_stroke" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Search by customer or device..." android:singleLine="true" android:textColor="@color/text_dark" android:textColorHint="@color/brand_muted" android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:paddingStart="16dp" android:paddingEnd="16dp" android:clipToPadding="false" android:layout_marginBottom="12dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.chip.Chip android:id="@+id/chipAll" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginEnd="8dp" android:text="All" android:textColor="@color/brand_navy" style="@style/Widget.MaterialComponents.Chip.Filter" app:chipBackgroundColor="@color/brand_lime" app:chipCornerRadius="19dp" />
            <com.google.android.material.chip.Chip android:id="@+id/chipPending" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginEnd="8dp" android:text="Pending" android:textColor="@color/brand_navy" style="@style/Widget.MaterialComponents.Chip.Filter" app:chipBackgroundColor="@color/white" app:chipCornerRadius="19dp" />
            <com.google.android.material.chip.Chip android:id="@+id/chipApproved" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginEnd="8dp" android:text="Approved" android:textColor="@color/brand_navy" style="@style/Widget.MaterialComponents.Chip.Filter" app:chipBackgroundColor="@color/white" app:chipCornerRadius="19dp" />
            <com.google.android.material.chip.Chip android:id="@+id/chipReadyToClaim" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginEnd="8dp" android:text="Ready to Claim" android:textColor="#7E22CE" style="@style/Widget.MaterialComponents.Chip.Filter" app:chipBackgroundColor="#F3E8FF" />
            <com.google.android.material.chip.Chip android:id="@+id/chipCompleted" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginEnd="8dp" android:text="Completed" android:textColor="@color/brand_navy" style="@style/Widget.MaterialComponents.Chip.Filter" app:chipBackgroundColor="@color/white" app:chipCornerRadius="19dp" />
            <com.google.android.material.chip.Chip android:id="@+id/chipCancelled" android:layout_width="wrap_content" android:layout_height="38dp" android:text="Cancelled" android:textColor="@color/brand_navy" style="@style/Widget.MaterialComponents.Chip.Filter" app:chipBackgroundColor="@color/white" app:chipCornerRadius="19dp" />
        </LinearLayout>
    </HorizontalScrollView>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAppointments" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="24dp" android:clipToPadding="false" />
</LinearLayout>